{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "roundtableCDR",
  "version": "0.0.2",
  "identifier": "com.hiroyats.saladereunioes",
  "build": {
    "beforeDevCommand": "npm run dev -w @saladereunioes/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w @saladereunioes/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "roundtableCDR",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    }
  }
}
